(defcfg
  linux-dev /dev/input/by-path/platform-i8042-serio-0-event-kbd
  linux-continue-if-no-devs-found yes
  process-unmapped-keys yes
  log-layer-changes yes
  danger-enable-cmd yes
  concurrent-tap-hold yes
)

;; Variables
(defvar
 tap-time 100
 hold-time 100
 chord-time 60
)

(defsrc
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps   a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft   z    x    c    v    b    n    m    ,    .    /    ▲    rsft
  lctl        lalt lmet          spc        rmet ralt ◀    ▼    ▶
)


(deflayer default
 esc            f1            f2           f3            f4           f5            f6            f7           f8           f9           f10          f11          f12
 grv            1             2            3             4            5             6             7            8            9            0            -            =    bspc
 tab            q             w            e             r            t             y             u            i            o            p            [            ]    \
 @ltsymbc       a             s            d             f            g             h             j            k            l            ;            '            ret
 lsft           z             x            c             v            b             n             m            ,            .            /            ▲            rsft
 lctl                         lalt         lmet          spc                                                   rmet         ralt         ◀            ▼            ▶
 )



(deflayer term
  esc           f1           f2           f3           f4             f5           f6           f7           f8               f9           f10          f11          f12
  grv           1            2            3            @lssymb        5            6            7            8                9            0            -            =    bspc
  tab           q            w            e            r              t            y            u            i                o            p            [            ]    \
  caps          @lsapps      s            d            f              g            h            j            k                l            ;            '            ret
  lsft          z            x            c            v              b            n            m            ,                .            /            ▲            rsft
  lctl                       lalt         lmet         @lsdefault                                            rmet             ralt         ◀            ▼            ▶
)


(deflayer apps
 esc            f1            f2           f3            f4           f5            f6            f7           f8           f9           f10          f11          f12
 grv            1             2            3             4            5             6             7            8            9            0            -            =    bspc
 tab            q             @appwhats    @appexp       r            XX            @appyt        u            @appinks     @appobs      @apppavu     [            ]    \
 @ltsymbc       a             @appsteam    @appdis       XX           @appgimp      @apphtop      j            @appkden     @applutr     ;            '            ret
 lsft           @appzath      @appexcal    c             @appvici     b             @appobn       @appmusic    ,            .            /            ▲            rsft
 lctl                         lalt         lmet          @lsdefault                                            rmet         ralt         ◀            ▼            ▶
 )

(deflayer navi
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv       1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab       q    w    e    r    t    y    u    i    o    p    [    ]    \
  @ltsymbc  a    s    d    f    g    ◀    ▼    ▲    ▶    ;    '    ret
  lsft      z    x    c    v    b    n    m    ,    .    /    ▲    rsft
  lctl           lalt lmet     @lsdefault      rmet ralt ◀    ▼    ▶
)

(deflayer symb
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10       f11  f12
  grv    S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0       -    =    bspc
  tab    S--  S-8  '    S-'  S-4  S-6  S-[  S-]  grv  S-grv     [    ]    \
  caps   S-=  -    /    =    S-7  S-\  S-9  S-0  S-;  ;         '    ret
  lsft   S-2  S-3  S-,  S-.  S-/  [    ]    ,    .    /    ▲         rsft
  lctl        lalt lmet         spc         rmet ralt ◀    ▼    ▶
)

;;commands

(defalias 
    appwhats                (cmd bash -c "echo 'TODO: Whatsapp'")
    appexp                  (cmd sudo -u chethan nautilus)
    appyt                   (cmd bash -c "echo 'TODO : youtube'")
    appinks                 (cmd sudo -u chethan -- inkscape)
    appobs                  (cmd sudo -u chethan obs)
    apppavu                 (cmd sudo -u chethan -- pavucontrol)
    appsteam                (cmd sudo -u chethan steam)
    appdis                  (cmd sudo -u chethan discord)
    appgimp                 (cmd sudo -u chethan gimp)
    apphtop                 (cmd sudo -u chethan -- kitty -e 'htop')
    appkden                 (cmd sudo -u chethan kdenlive)
    applutr                 (cmd lutris)
    appzath                 (cmd sudo -u chethan zathura)
    appexcal                (cmd bash -c "echo 'TODO: Excalidraw'")
    appvici                 (cmd vicinae toggle)
    appobn                  (cmd sudo -u chethan obsidian)
    appmusic                (cmd sudo -u chethan g4music)
)

;; toggle aliases

(defalias 
  ltsymbc (tap-hold 50 50 caps (layer-toggle symb))
)

;; switch aliases

(defalias
   lsnavi (layer-switch navi)
   lsdefault (layer-switch default)
   lssymb (layer-switch symb)
   lsterm (layer-switch term)
   lsapps (layer-switch apps)
)

(defchordsv2
    (lmet tab) @lsterm 50 all-released ()
)
